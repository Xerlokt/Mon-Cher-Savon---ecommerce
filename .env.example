# Copy to .env — never commit real values.
DATABASE_URL=postgresql://savon:savon@localhost:5432/mon_cher_savon

# API
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# "mercadopago" (default) or "fake" (local UI demos only; webhooks cannot approve fake payments)
PAYMENT_MODE=mercadopago
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxx
ORDER_EXPIRATION_MINUTES=30
SHIPPING_PICKUP_CENTS=0
SHIPPING_LOCAL_CENTS=1000
SHIPPING_FLAT_CENTS=2500

# Web
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
SITE_URL=http://localhost:3000

# Sale notifications (a channel is only usable when its credentials are set)
TELEGRAM_BOT_TOKEN=xxxx
# TELEGRAM_API_BASE_URL=http://localhost:4010   # local mock for tests/demos
WHATSAPP_CLOUD_TOKEN=xxxx
WHATSAPP_PHONE_NUMBER_ID=xxxx
WHATSAPP_TEMPLATE_NAME=nova_venda
OUTBOX_POLL_MS=5000
WORKER_ENABLED=true
# Temporary admin bearer token until the seller login (stage 5). Leave empty to close /admin.
ADMIN_BOOTSTRAP_TOKEN=

# Stage 5 (seller login)
SESSION_SECRET=change-me
