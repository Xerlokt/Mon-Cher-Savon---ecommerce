{
  "name": "@mon-cher-savon/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-admin": "tsx prisma/seed-admin.ts",
    "db:reset-demo": "tsx prisma/reset-demo.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@mon-cher-savon/config": "workspace:*",
    "@mon-cher-savon/contracts": "workspace:*",
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/swagger": "^8.0.1",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.45.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.3",
    "@nestjs/testing": "^12.1.2",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.3",
    "msw": "^3.0.3",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3"
  }
}
