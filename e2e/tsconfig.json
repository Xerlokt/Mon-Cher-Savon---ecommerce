{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "support/*.mjs"]
}
